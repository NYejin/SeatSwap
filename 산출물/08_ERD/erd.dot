// SeatSwap ERD -- 현재 스키마: V1+V2+V3 (users, performance, performance_session, ticket 4개 테이블)
// 생성: dot -Tpng erd.dot -o ERD.png   (한글 라벨: 나눔고딕 등 한글 폰트 필요)
// 2026-10-07 방향 전환으로 좌석표 트랙(좌석표·수정 로그·신고·제재 테이블)과 미구현 교환·채팅·후기 테이블을 제외하고 새로 작성.
// 이전 설계(12~16개 테이블)는 git 태그 archive/seatmap-track-20261007 에 보관되어 있다.
// 기준: SeatSwap/backend/src/main/resources/db/migration/V1__init_schema.sql + V2__drop_venue_use_venue_name.sql + V3__ticket_seat_columns.sql
// 2026-10-08: V3에서 ticket에 구역·열·번(label+key)·status·시각 추가(구현 완료). 나머지 교환 도메인은 예정(V4~)
// 2026-10-08: V2에서 venue 테이블 삭제, 공연장은 performance.venue_name 텍스트(등록 후 수정 불가)
// 시각 컬럼(created_at, updated_at, starts_at 등)은 모두 KST(Asia/Seoul) 벽시계 시각
digraph SeatSwapERD {
  graph [rankdir=LR, fontname="NanumGothic,Malgun Gothic", fontsize=12, labelloc=t, nodesep=0.5, ranksep=1.2, splines=true,
         label=<<B>SeatSwap ERD - 현재 스키마 (V1~V3, 4개 테이블)</B><BR/>시각 컬럼은 모두 KST 기준 / 교환 도메인(희망 범위·매칭·채팅 등 V4)은 설계 예정>];
  node  [shape=plain, fontname="NanumGothic,Malgun Gothic", fontsize=10];
  edge  [fontname="NanumGothic,Malgun Gothic", fontsize=9, dir=both, arrowtail=tee, arrowhead=crow];

  // ---------- 범례 ----------
  legend [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#DDDDDD"><B>범례</B></TD></TR>
      <TR><TD BGCOLOR="#FFFFFF" WIDTH="18"> </TD><TD ALIGN="LEFT">현재 (V1~V3)</TD></TR>
      <TR><TD>PK/FK/UK</TD><TD ALIGN="LEFT">키 / 제약</TD></TR>
      <TR><TD>NN</TD><TD ALIGN="LEFT">NOT NULL</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC" WIDTH="18"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">예정 (설계 초안, 미구현)</TD></TR>
    </TABLE>>];

  // ---------- 회원 ----------
  users [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>users</B> (User)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">email (255, NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">nickname (255, NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">password (255, NN, BCrypt)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">trust_score (DOUBLE)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">role (USER/ADMIN, NN, 기본 USER, utf8mb4_bin + CHECK)</TD></TR>
    </TABLE>>];

  // ---------- 공연 / 회차 ----------
  performance [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>performance</B> (Performance)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">registrant_id → users (NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">title (200, NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">venue_name VARCHAR(100) NN (공연장 이름 텍스트, 등록 후 수정 불가)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">source_url (2048, NN)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">source_key (500, NN, utf8mb4_bin)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at / updated_at (NN)</TD></TR>
    </TABLE>>];

  performance_session [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>performance_session</B> (PerformanceSession)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK,UK</TD><TD ALIGN="LEFT">performance_id → performance (NN)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">starts_at (NN, 분 단위, KST)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at (NN)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">uk_performance_session_performance_starts_at (performance_id, starts_at)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx_performance_session_starts_at (starts_at)</TD></TR>
    </TABLE>>];

  // ---------- 티켓 ----------
  ticket [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#BDD7EE"><B>ticket</B> (Ticket)</TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">user_id → users (NN, 보유자)</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">performance_session_id → performance_session (NN)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">zone_label VARCHAR(50) NN (구역, 표시용)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">zone_key VARCHAR(50) NN (bin, 정규화 키)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">row_label VARCHAR(20) NN (열, 표시용)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">row_key VARCHAR(20) NN (bin, 정규화 키)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">col_label VARCHAR(20) NN (번, 표시용)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">col_key VARCHAR(20) NN (bin, 정규화 키)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">status (ACTIVE/INACTIVE, NN, 기본 ACTIVE, bin + CHECK)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">active_flag TINYINT (생성 컬럼: ACTIVE면 1, 아니면 NULL)</TD></TR>
      <TR><TD> </TD><TD ALIGN="LEFT">created_at / updated_at (NN)</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">uk_ticket_active_seat (performance_session_id, zone_key, row_key, col_key, active_flag)</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT">idx_ticket_user_status (user_id, status)</TD></TR>
    </TABLE>>];

  // ---------- 주석 노드 ----------
  note_scope [shape=note, fontsize=10, label="교환 범위는 공연(Performance) 단위 (2026-10-07):\l같은 공연의 다른 회차 티켓끼리도 교환 가능.\lticket은 회차만 참조하고 공연은 performance_session.performance로 얻는다.\l"];
  note_design [shape=note, fontsize=10, style=filled, fillcolor="#FFF2CC", label="노란색 = 예정 (V4 설계 확정안, 구현 전. ticket 변경은 V3로 구현 완료)\l상세: 산출물/08_ERD/exchange-schema-design.md\l후기·신뢰도 테이블 없음, 신고는 후속.\l"];

  // ---------- 예정: 교환 도메인 (V4 신규; ticket 변경은 V3로 구현 완료) ----------
  exchange_request [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>exchange_request</B> (예정, V4)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK,UK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">ticket_id → ticket (NN, 티켓당 1개)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">extra_type (X/ANY/POS/NEG)  추가금 X/상관없음/받아야만(+)/낼 의향(-)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">extra_amount INT NULL (POS/NEG일 때만, 참고 표시용, 매칭 계산 안 함)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">status (OPEN/CLOSED), created_at, updated_at</TD></TR>
    </TABLE>>];

  exchange_want_range [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>exchange_want_range</B> (예정, V4)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">request_id → exchange_request</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">zone_label/zone_key, row_from/row_to, col_from/col_to, sort_order</TD></TR>
    </TABLE>>];

  exchange_want_seat [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>exchange_want_seat</B> (예정, V4, 펼친 좌석)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">request_id → exchange_request</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">zone_key, row_key, col_key</TD></TR>
    </TABLE>>];

  exchange_want_session [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>exchange_want_session</B> (예정, V4, 희망 회차)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">request_id → exchange_request</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">performance_session_id → performance_session</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">priority SMALLINT NN (사용자 설정)</TD></TR>
    </TABLE>>];

  user_block [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>user_block</B> (예정, V4)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK,UK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">blocker_id → users</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK,UK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">blocked_id → users</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">created_at</TD></TR>
    </TABLE>>];

  exchange_match [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>exchange_match</B> (예정, V4)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">request_a_id, request_b_id → exchange_request</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">user_a_id, user_b_id → users</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">status (CHATTING/RESERVED/COMPLETED/CANCELED) 취소=재매칭 가능</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">a/b_reserved_at, a/b_completed_at, canceled_by_id(NULL=시스템), canceled_at</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">UK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">(request_low, request_high, open_flag) 생성 컬럼</TD></TR>
    </TABLE>>];

  exchange_ticket_lock [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>exchange_ticket_lock</B> (예정, V4, 예약 잠금)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK,FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">ticket_id → ticket (티켓당 1개)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">match_id → exchange_match</TD></TR>
    </TABLE>>];

  chat_message [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>chat_message</B> (예정, 최소안)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">match_id → exchange_match</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">sender_id → users</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">content (1000), created_at</TD></TR>
    </TABLE>>];

  exchange_history [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
      <TR><TD COLSPAN="2" BGCOLOR="#F4B183"><B>exchange_history</B> (예정, V4, 스냅샷)</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">PK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK,UK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">match_id → exchange_match, user_id → users</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC">FK</TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">counterpart_user_id, ticket_id, performance_id</TD></TR>
      <TR><TD BGCOLOR="#FFF2CC"> </TD><TD ALIGN="LEFT" BGCOLOR="#FFF2CC">from_/to_ starts_at, zone, row, col (스냅샷), completed_at</TD></TR>
    </TABLE>>];

  // ---------- 관계 ----------
  performance -> performance_session [label="1:N"];
  performance_session -> ticket [label="1:N"];
  users -> ticket [label="1:N 보유자"];
  users -> performance [label="1:N 등록자"];

  // ---------- 예정 관계 (노란색 계열 점선) ----------
  ticket -> exchange_request [style=dashed, color="#C55A11", label="1:1"];
  exchange_request -> exchange_want_range [style=dashed, color="#C55A11", label="1:N"];
  exchange_request -> exchange_want_seat [style=dashed, color="#C55A11", label="1:N 펼침"];
  exchange_request -> exchange_want_session [style=dashed, color="#C55A11", label="1:N"];
  performance_session -> exchange_want_session [style=dashed, color="#C55A11", label="1:N"];
  exchange_request -> exchange_match [style=dashed, color="#C55A11", label="1:N (a측/b측)"];
  users -> exchange_match [style=dashed, color="#C55A11", label="1:N (a/b)"];
  users -> user_block [style=dashed, color="#C55A11", label="1:N 차단자/피차단자"];
  exchange_match -> exchange_ticket_lock [style=dashed, color="#C55A11", label="1:N (최대 2)"];
  ticket -> exchange_ticket_lock [style=dashed, color="#C55A11", label="1:0..1"];
  exchange_match -> chat_message [style=dashed, color="#C55A11", label="1:N"];
  exchange_match -> exchange_history [style=dashed, color="#C55A11", label="1:N (최대 2)"];
  users -> exchange_history [style=dashed, color="#C55A11", label="1:N"];

  // ---------- 배치 보조 ----------
  legend -> users [style=invis];
  performance_session -> note_scope [style=dotted, arrowhead=none, arrowtail=none, color=gray, label=""];
  ticket -> note_design [style=dotted, arrowhead=none, arrowtail=none, color=gray, label=""];
}
